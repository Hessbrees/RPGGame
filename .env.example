# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_DB_PATH=./chroma_db

# Game settings
GAME_NAME=RPGGame

# Image generation (off | inline | deferred)
IMAGE_GEN_MODE=off
IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
# Ścieżki do wag LoRA rozdzielone średnikiem, np. ./outputs/lora/style_r16/best
IMAGE_LORA_PATHS=
IMAGE_LORA_SCALE=0.8
IMAGE_STEPS=25
IMAGE_GUIDANCE=7.0
IMAGE_SEED=42
IMAGE_OUTPUT_DIR=./outputs/images
IMAGE_IMPORTANCE_THRESHOLD=4
IMAGE_MAX_IMAGES=20
IMAGE_UNLOAD_OLLAMA=true
